# Copy this file to .env and fill in values before deploying.
# Generate JWT secrets with: openssl rand -base64 48

# ── Gateway ───────────────────────────────────────────────────────────────────
PORT=4000

# The base domain for tunnel subdomains.
# Production example: yourdomain.dev
# Local Docker example: localhost:4000
BASE_DOMAIN=yourdomain.dev

# Origin allowed to call /api with credentials (your dashboard URL).
DASHBOARD_ORIGIN=https://app.yourdomain.dev

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_base64_48

# Optional — tune token lifetimes (defaults shown)
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_SEC=604800

# ── Dashboard build URL ───────────────────────────────────────────────────────
# Used by docker-compose.prod.yml as the VITE_API_BASE_URL build arg.
# Must match the URL users use to open the dashboard (where Nginx serves it).
APP_URL=https://app.yourdomain.dev

# ── Optional tuning ───────────────────────────────────────────────────────────
# REQUEST_TIMEOUT_MS=30000
# MAX_REQUEST_BODY_BYTES=10485760
# HEARTBEAT_INTERVAL_MS=30000
# HEARTBEAT_TIMEOUT_MS=60000
